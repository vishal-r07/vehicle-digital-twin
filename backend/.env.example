# ============================================================================
# AutoTwin AI - Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control!
# ============================================================================

# --- Application ---
APP_NAME=AutoTwin AI
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=true

# --- Serial Communication ---
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
SERIAL_TIMEOUT=1.0
SERIAL_RECONNECT_INTERVAL=2.0

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=20
WS_MAX_CONNECTIONS=50

# --- Database ---
DATABASE_URL=sqlite:///./autotwin.db
DATABASE_ECHO=false

# --- CAN Configuration ---
CAN_BAUD_RATE=500000
CAN_BUFFER_SIZE=1000

# --- Broadcast ---
BROADCAST_INTERVAL_MS=50
BROADCAST_INCLUDE_TIMESTAMP=true

# --- Diagnostics ---
FAULT_COOLDOWN_S=30
HEALTH_UPDATE_INTERVAL_S=10
TIMELINE_MAX_EVENTS=10000

# --- Vehicle Plugins ---
VEHICLES_DIR=./vehicles
SCENARIOS_DIR=./scenarios

# --- CORS (allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Security (Phase 2+) ---
# SECRET_KEY=change-this-to-a-random-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60